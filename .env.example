APP_NAME=Telecom AI Support Assistant
ENVIRONMENT=development

# ----------------------------------------------------------------------
# Model selection: demo | anthropic | openai
# ----------------------------------------------------------------------
# A provider named here without its API key degrades to demo mode rather than
# failing to start. /health reports the degradation.
LLM_PROVIDER=demo

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------------------------------
# Routing strategy: rules | agent
# ----------------------------------------------------------------------
# rules — the application classifies the request and calls one tool.
#         Deterministic, inspectable, and the only mode that works keyless.
# agent — the model receives the tool schemas and decides what to call, via
#         real function calling. Needs a tool-capable provider; otherwise it
#         degrades to rules.
ROUTING_MODE=rules
AGENT_MAX_ITERATIONS=5

# ----------------------------------------------------------------------
# Generation
# ----------------------------------------------------------------------
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=8192
# Anthropic effort: low | medium | high | xhigh | max
LLM_EFFORT=low

# Conversation turns passed back to the model and scanned for identifiers.
HISTORY_MAX_TURNS=8

LOG_LEVEL=INFO
# "json" for machine-readable logs, "text" for readable local development.
LOG_FORMAT=json
