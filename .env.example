APP_NAME=Telecom AI Support Assistant
ENVIRONMENT=development

# Set LLM_PROVIDER=openai AND a non-empty OPENAI_API_KEY to enable live LLM mode.
# Either one alone leaves the app in demo mode; /health reports which is active.
LLM_PROVIDER=demo
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=20

# Conversation turns passed back to the model and scanned for identifiers.
HISTORY_MAX_TURNS=8

LOG_LEVEL=INFO
# "json" for machine-readable logs, "text" for readable local development.
LOG_FORMAT=json
